# Copy this file to .env.local and fill in the keys you have.
# With no AI key at all, Orbit runs in demo mode with a scripted run.

# Free: Google Gemini. Get a key at https://aistudio.google.com/apikey (no card needed).
GEMINI_API_KEY=
# Optional: first model to try. If it is busy, Orbit falls back to gemini-flash-lite-latest, then gemini-flash-latest (each model has its own daily quota).
# GEMINI_MODEL=gemini-2.5-flash

# Free: web search through Tavily, 1,000 searches a month. Get a key at https://app.tavily.com
# Without it, agents work from the model's own knowledge and mark facts as unverified.
TAVILY_API_KEY=

# Paid, optional: Claude (used only when GEMINI_API_KEY is empty). Includes built-in web search.
# ANTHROPIC_API_KEY=
